<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra de navegación inferior + FAB. Vive UNA sola vez en activity_main.xml
    y la maneja MainActivity.java (clicks + resaltado de la pestaña activa),
    para que sea compartida entre todas las pantallas (Home, Clientes, etc.)
    en vez de repetirse en cada fragment.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/card_background"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:weightSum="6">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavInicio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvNavInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navPresupuestos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavPresupuestos"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_budget"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvNavPresupuestos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presupuestos"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Espacio reservado para el FAB central -->
        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/navClientes"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavClientes"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_client"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvNavClientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clientes"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCobros"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavCobros"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_nav_collect"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvNavCobros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cobros"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavMas"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_more"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvNavMas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Más"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
