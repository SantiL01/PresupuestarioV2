<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar Cobro"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Spinner
            android:id="@+id/spinnerClienteCobro"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnAtajoClienteCobro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Nuevo"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="@color/primary_blue"/>
    </LinearLayout>

    <EditText
        android:id="@+id/etCodigoCobro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Código (Ej: #00088)"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etMontoCobro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Monto a cobrar ($)"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp"/>
</LinearLayout>